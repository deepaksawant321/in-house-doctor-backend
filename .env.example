# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (SQL Server) ─────────────────────────────────────────────────
# SQL authentication (default):
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=change-me
DB_NAME=InHouseDoctorDB
# Windows Integrated Authentication (e.g. local SQL Express) — uses msnodesqlv8 + ODBC Driver 17:
# DB_TRUSTED=true
# DB_HOST=MACHINE-NAME\SQLEXPRESS

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED: the API refuses to start without it. Use a long random value (>= 32 chars).
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRES_IN=1d

# ── HTTP ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Include BOTH the apex and www origins in production.
CORS_ORIGINS=https://doctordoorstep.com,https://www.doctordoorstep.com,http://localhost:3000
# Max requests per 15 min per IP on login / OTP / contact endpoints (default 30)
# AUTH_RATE_LIMIT_MAX=30
# Swagger UI at /api/docs is only served when NODE_ENV != production, unless this is "true"
# SWAGGER_ENABLED=false

# ── Email (SMTP) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="InHouseDoctor <no-reply@example.com>"
# Receives new-booking / payment-proof alerts and website contact messages
ADMIN_EMAIL=

# ── Testing / integrations ────────────────────────────────────────────────
# NEVER enable in production (the API refuses to start if NODE_ENV=production): echoes the OTP in the send-otp response for local testing.
# EXPOSE_DEV_OTP=true
# DEV ONLY simulated gateway: auto-marks payments Success after 2s. Ignored (and the API refuses to start) when NODE_ENV=production. Default is off; patients pay via UPI + proof upload.
# MOCK_PAYMENT_GATEWAY=true
# MSG91 / Twilio (SMS providers are not wired to the OTP flow yet)
# MSG91_AUTH_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
